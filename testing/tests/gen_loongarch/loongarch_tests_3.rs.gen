
#[test]
fn vmulwev_d_wu_2400() {
    let mut ops = dynasmrt::loongarch::Assembler::new().unwrap();
    dynasm!(ops
        ; .arch loongarch64
        ; vmulwev.d.wu v3, v18, v0
    );
    let buf = ops.finalize().unwrap();
    let hex: Vec<String> = buf.iter().map(|x| format!("{:02X}", *x)).collect();
    let hex = hex.join(", ");
    assert_eq!(hex, "43, 02, 99, 70", "vmulwev.d.wu v3, v18, v0");
}

