
#[test]
fn vssrln_wu_d_3200() {
    let mut ops = dynasmrt::loongarch::Assembler::new().unwrap();
    dynasm!(ops
        ; .arch loongarch64
        ; vssrln.wu.d v8, v13, v19
    );
    let buf = ops.finalize().unwrap();
    let hex: Vec<String> = buf.iter().map(|x| format!("{:02X}", *x)).collect();
    let hex = hex.join(", ");
    assert_eq!(hex, "A8, CD, 05, 71", "vssrln.wu.d v8, v13, v19");
}

