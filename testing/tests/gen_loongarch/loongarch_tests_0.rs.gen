    dynasm!(ops
        ; .arch loongarch64
        ; fmadd.s f28, f22, f6, f23
    );
    let buf = ops.finalize().unwrap();
    let hex: Vec<String> = buf.iter().map(|x| format!("{:02X}", *x)).collect();
    let hex = hex.join(", ");
    assert_eq!(hex, "DC, 9A, 1B, 08", "fmadd.s f28, f22, f6, f23");
}

