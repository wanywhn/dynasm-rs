    dynasm!(ops
        ; .arch loongarch64
        ; fcmp.caf.s fcc2, f6, f25
    );
    let buf = ops.finalize().unwrap();
    let hex: Vec<String> = buf.iter().map(|x| format!("{:02X}", *x)).collect();
    let hex = hex.join(", ");
    assert_eq!(hex, "C2, 64, 10, 0C", "fcmp.caf.s fcc2, f6, f25");
}

