
#[test]
fn xvftintrm_l_d_4000() {
    let mut ops = dynasmrt::loongarch::Assembler::new().unwrap();
    dynasm!(ops
        ; .arch loongarch64
        ; xvftintrm.l.d v10, v9
    );
    let buf = ops.finalize().unwrap();
    let hex: Vec<String> = buf.iter().map(|x| format!("{:02X}", *x)).collect();
    let hex = hex.join(", ");
    assert_eq!(hex, "2A, 3D, 9E, 76", "xvftintrm.l.d v10, v9");
}

