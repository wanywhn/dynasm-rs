
#[test]
fn xvfnmadd_d_4000() {
    let mut ops = dynasmrt::loongarch::Assembler::new().unwrap();
    dynasm!(ops
        ; .arch loongarch64
        ; xvfnmadd.d v30, v21, v31, v19
    );
    let buf = ops.finalize().unwrap();
    let hex: Vec<String> = buf.iter().map(|x| format!("{:02X}", *x)).collect();
    let hex = hex.join(", ");
    assert_eq!(hex, "BE, FE, A9, 0A", "xvfnmadd.d v30, v21, v31, v19");
}

