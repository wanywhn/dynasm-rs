
#[test]
fn xvftintrm_w_d_4000() {
    let mut ops = dynasmrt::loongarch::Assembler::new().unwrap();
    dynasm!(ops
        ; .arch loongarch
        ; xvftintrm.w.d v21, v23, v19
    );
    let buf = ops.finalize().unwrap();
    let hex: Vec<String> = buf.iter().map(|x| format!("{:02X}", *x)).collect();
    let hex = hex.join(", ");
    assert_eq!(hex, "F5, 4E, 4A, 75", "xvftintrm.w.d v21, v23, v19");
}

