
#[test]
fn vfcmp_sne_d_1600() {
    let mut ops = dynasmrt::loongarch::Assembler::new().unwrap();
    dynasm!(ops
        ; .arch loongarch64
        ; vfcmp.sne.d v15, v13, v17
    );
    let buf = ops.finalize().unwrap();
    let hex: Vec<String> = buf.iter().map(|x| format!("{:02X}", *x)).collect();
    let hex = hex.join(", ");
    assert_eq!(hex, "AF, C5, 68, 0C", "vfcmp.sne.d v15, v13, v17");
}

