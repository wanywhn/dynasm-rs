    dynasm!(ops
        ; .arch loongarch64
        ; vfrint.d v28, v24
    );
    let buf = ops.finalize().unwrap();
    let hex: Vec<String> = buf.iter().map(|x| format!("{:02X}", *x)).collect();
    let hex = hex.join(", ");
    assert_eq!(hex, "1C, 3B, 9D, 72", "vfrint.d v28, v24");
}

