
#[test]
fn vfcmp_sne_s_1600() {
    let mut ops = dynasmrt::loongarch::Assembler::new().unwrap();
    dynasm!(ops
        ; .arch loongarch
        ; vfcmp.sne.s v25, v5, v18
    );
    let buf = ops.finalize().unwrap();
    let hex: Vec<String> = buf.iter().map(|x| format!("{:02X}", *x)).collect();
    let hex = hex.join(", ");
    assert_eq!(hex, "B9, C8, 58, 0C", "vfcmp.sne.s v25, v5, v18");
}

