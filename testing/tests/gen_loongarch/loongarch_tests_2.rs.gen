#[test]
fn vfcmp_clt_d_1645() {
    let mut ops = dynasmrt::loongarch::Assembler::new().unwrap();
    dynasm!(ops
        ; .arch loongarch64
        ; vfcmp.clt.d v9, v14, v10
    );
