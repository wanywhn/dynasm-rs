    let hex: Vec<String> = buf.iter().map(|x| format!("{:02X}", *x)).collect();
    let hex = hex.join(", ");
    assert_eq!(hex, "82, 0D, 8F, 73", "vextrins.b v2, v12, 195");
}

#[test]
