    let hex: Vec<String> = buf.iter().map(|x| format!("{:02X}", *x)).collect();
    let hex = hex.join(", ");
    assert_eq!(hex, "26, FB, 53, 0C", "vfcmp.sle.s v6, v25, v30");
}

